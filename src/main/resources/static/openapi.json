{
  "openapi": "3.1.0",
  "info": {
    "title": "Student Discounts — public Catalog API",
    "version": "0.2.0",
    "description": "Only public card data. Internal /catalog/v1 routes are not public gateway routes. Schedule is displayed; only status and overall validity dates filter offers."
  },
  "paths": {
    "/api/v1/catalog/places/{id}": {
      "get": {
        "operationId": "getPlaceCard",
        "summary": "Полная карточка места с действующими предложениями",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ACTIVE предложения внутри общего срока по часовому поясу места",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceCard"
                }
              }
            }
          },
          "400": {
            "description": "Некорректный UUID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Место отсутствует либо нет публичных предложений",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Location": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "additionalProperties": false
      },
      "Category": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "additionalProperties": false
      },
      "Source": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "WEBSITE",
              "SOCIAL_MEDIA",
              "ORGANIZATION",
              "PERSONAL_VISIT",
              "OTHER"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "type",
          "url"
        ],
        "additionalProperties": false
      },
      "ScheduleInterval": {
        "type": "object",
        "properties": {
          "dayOfWeek": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "timeFrom": {
            "type": "string",
            "example": "10:00"
          },
          "timeUntil": {
            "type": "string",
            "example": "24:00"
          }
        },
        "required": [
          "dayOfWeek",
          "timeFrom",
          "timeUntil"
        ],
        "additionalProperties": false
      },
      "Offer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "conditions": {
            "type": "string",
            "maxLength": 2000
          },
          "discountType": {
            "type": "string",
            "enum": [
              "PERCENT",
              "FIXED_AMOUNT",
              "SPECIAL_PRICE",
              "FREE_ITEM",
              "OTHER"
            ]
          },
          "discountValue": {
            "type": [
              "number",
              "null"
            ]
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastVerifiedAt": {
            "type": "string",
            "format": "date-time"
          },
          "validFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "schedule": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleInterval"
            }
          }
        },
        "required": [
          "id",
          "conditions",
          "discountType",
          "discountValue",
          "source",
          "lastVerifiedAt",
          "validFrom",
          "validUntil",
          "schedule"
        ],
        "additionalProperties": false
      },
      "PlaceCard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "addressLine": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "timezone": {
            "type": "string"
          },
          "offers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/Offer"
            }
          }
        },
        "required": [
          "id",
          "name",
          "city",
          "addressLine",
          "location",
          "category",
          "timezone",
          "offers"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          },
          "instance": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      }
    }
  }
}
