{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:student-discounts:catalog:changed:v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "const": "CatalogChanged"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "placeId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "properties": {
        "place": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "placeName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "addressLine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            "location": {
              "type": "object",
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latitude",
                "longitude"
              ],
              "additionalProperties": false
            },
            "categoryCode": {
              "type": "string",
              "maxLength": 50,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "categoryName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "\\S"
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "revision",
            "placeName",
            "city",
            "addressLine",
            "location",
            "categoryCode",
            "categoryName",
            "timezone"
          ],
          "additionalProperties": false
        },
        "offers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "offerId": {
                "type": "string",
                "format": "uuid"
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "status": {
                "type": "string",
                "enum": [
                  "ACTIVE",
                  "SUSPENDED",
                  "EXPIRED",
                  "ARCHIVED"
                ]
              },
              "discountType": {
                "type": "string",
                "enum": [
                  "PERCENT",
                  "FIXED_AMOUNT",
                  "SPECIAL_PRICE",
                  "FREE_ITEM",
                  "OTHER"
                ]
              },
              "discountValue": {
                "type": [
                  "number",
                  "null"
                ],
                "multipleOf": 0.01,
                "maximum": 99999999.99
              },
              "lastVerifiedAt": {
                "type": "string",
                "format": "date-time"
              },
              "validFrom": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "validUntil": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "schedule": {
                "type": "array",
                "maxItems": 7,
                "items": {
                  "type": "object",
                  "properties": {
                    "daysOfWeek": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 7,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 7
                      }
                    },
                    "intervals": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 28,
                      "items": {
                        "type": "object",
                        "properties": {
                          "timeFrom": {
                            "type": "string",
                            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                          },
                          "timeUntil": {
                            "type": "string",
                            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$"
                          }
                        },
                        "required": [
                          "timeFrom",
                          "timeUntil"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "daysOfWeek",
                    "intervals"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "offerId",
              "revision",
              "status",
              "discountType",
              "discountValue",
              "lastVerifiedAt",
              "validFrom",
              "validUntil",
              "schedule"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "discountType": {
                      "const": "PERCENT"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "discountValue": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "exclusiveMinimum": 0,
                      "maximum": 100
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "discountType": {
                      "const": "FIXED_AMOUNT"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "discountValue": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "discountType": {
                      "const": "SPECIAL_PRICE"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "discountValue": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "exclusiveMinimum": 0
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "discountType": {
                      "const": "FREE_ITEM"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "discountValue": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "discountType": {
                      "const": "OTHER"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "discountValue": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "place"
          ]
        },
        {
          "required": [
            "offers"
          ]
        }
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "occurredAt",
    "placeId",
    "data"
  ],
  "additionalProperties": false
}
